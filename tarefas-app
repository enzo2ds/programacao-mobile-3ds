import React, { useState, useEffect } from 'react';
import {
  View,
  Text,
  TextInput,
  Button,
  FlatList,
  TouchableOpacity,
  ActivityIndicator,
  StyleSheet,
  Alert,
} from 'react-native';

export default function App() {
  // ESTADOS DO APP
  const [textoTarefa, setTextoTarefa] = useState('');
  const [tarefas, setTarefas] = useState([]);
  const [carregando, setCarregando] = useState(true);

  // TODO 1: Criar a função que busca as 5 primeiras tarefas na API
  const buscarTarefasDaAPI = () => {
    fetch('https://jsonplaceholder.typicode.com/todos')
      .then((resposta) => resposta.json())
      .then((dados) => {
        // Pega apenas as 5 primeiras tarefas
        setTarefas(dados.slice(0, 5));

        // Finaliza o carregamento
        setCarregando(false);
      })
      .catch((erro) => {
        Alert.alert('Erro', 'Não foi possível carregar as tarefas');
        setCarregando(false);
      });
  };

  // TODO 2: Chamar a função assim que a tela abrir
  useEffect(() => {
    buscarTarefasDaAPI();
  }, []);

  // TODO 3: Adicionar uma nova tarefa na lista local
  const adicionarTarefa = () => {
    if (textoTarefa.trim() === '') {
      Alert.alert('Atenção', 'Digite uma tarefa!');
      return;
    }

    // Objeto da nova tarefa
    const novaItem = {
      id: Date.now().toString(),
      title: textoTarefa,
    };

    // Adiciona a nova tarefa mantendo as anteriores
    setTarefas([...tarefas, novaItem]);

    // Limpa o campo
    setTextoTarefa('');
  };

  // TODO 4: Remover uma tarefa pelo ID
  const removerTarefa = (idParaRemover) => {
    setTarefas(
      tarefas.filter((item) => item.id !== idParaRemover)
    );
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>📝 Minhas Tarefas</Text>

      {/* FORMULÁRIO DE ENTRADA */}
      <View style={styles.formulario}>
        <TextInput
          style={styles.input}
          placeholder="Digite uma nova tarefa..."
          value={textoTarefa}
          onChangeText={setTextoTarefa}
        />

        <Button
          title="Adicionar"
          color="#10ac84"
          onPress={adicionarTarefa}
        />
      </View>

      <Text style={styles.subtitulo}>
        Lista de Afazeres ({tarefas.length})
      </Text>

      {/* EXIBIÇÃO DA LISTA OU DO CARREGAMENTO */}
      {carregando ? (
        <View style={styles.areaCarregamento}>
          <ActivityIndicator size="large" color="#10ac84" />
          <Text style={styles.textoCarregando}>
            Buscando tarefas na nuvem...
          </Text>
        </View>
      ) : (
        <FlatList
          data={tarefas}
          keyExtractor={(item) => item.id.toString()}
          ListEmptyComponent={
            <Text style={styles.listaVazia}>
              Nenhuma tarefa pendente!
            </Text>
          }
          renderItem={({ item }) => (
            <View style={styles.card}>
              <Text style={styles.textoCard}>{item.title}</Text>

              <TouchableOpacity
                style={styles.botaoDeletar}
                onPress={() => removerTarefa(item.id)}
              >
                <Text style={styles.textoBotaoDeletar}>X</Text>
              </TouchableOpacity>
            </View>
          )}
        />
      )}
    </View>
  );
}

